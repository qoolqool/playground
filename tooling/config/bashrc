# ============================================
# PATH & ENVIRONMENT
# ============================================
export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"
export XDG_DATA_HOME=/home/tool/.local/share

# ============================================
# PROMPT & UI (Starship)
# ============================================
eval "$(starship init bash)"

# ============================================
# COLORS & APPEARANCE
# ============================================
export CLICOLOR=1
export LSCOLORS=GxFxCxDxBxegedabagaced

# Colorful ls
alias ls='ls --color=auto'
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# Colorful grep
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# ============================================
# GIT ALIASES & SHORTCUTS
# ============================================
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git pull'
alias gd='git diff'
alias gco='git checkout'
alias gb='git branch'
alias glog='git log --oneline --graph --decorate --all'
alias gls='git log --pretty=format:"%C(yellow)%h%Cred%d %Creset%s%Cblue [%cn]" --decorate'
alias gdt='git diff-tree --no-commit-id --name-only -r'

# Git functions
gac() {
  git add .
  git commit -m "$1"
}

git-cleanup() {
  git branch --merged | grep -v "\*" | grep -v "main" | grep -v "master" | xargs -n 1 git branch -d
}

# ============================================
# KUBERNETES ALIASES & SHORTCUTS
# ============================================
alias k='kubectl'
alias kgp='kubectl get pods'
alias kgs='kubectl get svc'
alias kgd='kubectl get deployments'
alias kgn='kubectl get nodes'
alias kga='kubectl get all'
alias kdp='kubectl describe pod'
alias kds='kubectl describe svc'
alias kdd='kubectl describe deployment'
alias kl='kubectl logs'
alias klf='kubectl logs -f'
alias kex='kubectl exec -it'
alias kdel='kubectl delete'
alias kctx='kubectl config current-context'
alias kns='kubectl config set-context --current --namespace'
alias kgns='kubectl get namespaces'

# Quick context switching
alias kc='kubectl config use-context'
alias kgc='kubectl config get-contexts'

# Kubectl completion
if [ -f /etc/bash_completion.d/kubectl ]; then
  source /etc/bash_completion.d/kubectl
  complete -F __start_kubectl k
fi

# ============================================
# CUSTOM K8S FUNCTIONS
# ============================================

# Quick k8s pod logs
klog() {
  kubectl logs -f $(kubectl get pods | grep $1 | head -1 | awk '{print $1}')
}

# Quick k8s pod exec
ksh() {
  kubectl exec -it $(kubectl get pods | grep $1 | head -1 | awk '{print $1}') -- /bin/bash
}

# Quick k8s pod exec with sh fallback
kshell() {
  POD=$(kubectl get pods | grep $1 | head -1 | awk '{print $1}')
  kubectl exec -it $POD -- /bin/bash 2>/dev/null || kubectl exec -it $POD -- /bin/sh
}

# Get pod resources
kres() {
  kubectl top pod $(kubectl get pods | grep $1 | head -1 | awk '{print $1}')
}

# ============================================
# GENERAL PRODUCTIVITY
# ============================================

# Better history
export HISTSIZE=10000
export HISTFILESIZE=20000
export HISTCONTROL=ignoredups:erasedups
shopt -s histappend

# Update window size after each command
shopt -s checkwinsize

# Navigation shortcuts
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# Quick grep for running processes
alias psg='ps aux | grep -v grep | grep -i -e VSZ -e'

# ============================================
# HELM SHORTCUTS
# ============================================
alias h='helm'
alias hls='helm list'
alias hla='helm list --all-namespaces'
alias hi='helm install'
alias hu='helm upgrade'
alias hd='helm delete'
alias hs='helm status'

# ============================================
# AI / OLLAMA ALIASES
# ============================================
alias ollama-run='ollama run'

# Launch pi with a local model (host's GPU via OLLAMA_HOST)
pi-local() {
  OLLAMA_HOST=${HOST_IP:-host.docker.internal}:11434 ollama launch pi --model "$@"
}
